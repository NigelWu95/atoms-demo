{
  "name": "atoms-demo-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.20.x",
    "npm": "11.19.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:fixtures": "vite --host 127.0.0.1 --mode fixtures",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:runtime": "playwright test --config playwright.runtime.config.ts",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src vite.config.ts playwright*.config.ts e2e e2e-runtime e2e-live",
    "format:check": "prettier --check src *.ts *.json *.js index.html e2e e2e-runtime e2e-live",
    "format": "prettier --write src *.ts *.json *.js index.html e2e e2e-runtime e2e-live"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
