# Copy to .env.local only on a fresh checkout; never overwrite existing credentials.
# Replace each value with a different cryptographically random 64-character hex string.
# Keep .env.local permissions at 600. Never commit real values.
APP_DB_PASSWORD=replace_with_64_random_hex_characters
TEST_DB_PASSWORD=replace_with_a_different_64_character_hex_password

# Server-side only. Append these keys to an existing .env.local; never replace DB credentials.
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_SECONDS=300
DEEPSEEK_MAX_TOKENS=163840
# Whole-run deadline (1..1800 seconds), independent from each model request timeout.
GENERATION_TIMEOUT_SECONDS=900
# Lifetime request ceiling for this database, not a currency budget; 0 disables paid requests.
GENERATION_MAX_MODEL_CALLS=0

# Optional trusted site origin, e.g. https://your-domain.example (no path).
# Empty means local-only publication links. Server template: deploy/server/.
PUBLIC_APP_ORIGIN=

# Optional platform email accounts; append to existing private config, never overwrite it.
# SMTP_PASSWORD is the QQ SMTP authorization code, NOT the QQ login password.
# EMAIL_CODE_HMAC_KEY must be a separate stable random 32-byte key (64 hex characters).
# Setup: docs/email-accounts.md. No automatic startup test mail is sent.
EMAIL_AUTH_ENABLED=false
# Temporary public HTTP demo only; does not enable email or disable Secure cookies.
# Loopback development does not need this. See docs/email-accounts.md before enabling.
EMAIL_AUTH_ALLOW_INSECURE_HTTP=false
# Separate opt-in for password operations over public HTTP; leave false.
# The email HTTP exception does NOT enable passwords. Loopback needs neither flag.
PASSWORD_AUTH_ALLOW_INSECURE_HTTP=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_CODE_HMAC_KEY=
# Application abuse budgets, not the provider's sending quota.
EMAIL_MAX_SENDS_PER_EMAIL=5
EMAIL_MAX_SENDS_PER_SESSION=10
EMAIL_MAX_SENDS_PER_IP=20
EMAIL_MAX_SENDS_PER_HOUR=20
EMAIL_MAX_SENDS_PER_DAY=100

# Optional built-in public ports for full engineering apps (no Nginx required).
# Requires the engineering execution / delivery configuration and an IPv4 address.
# Internal 18201..18204 remain loopback; offset 10000 exposes 28201..28204.
PROJECT_PUBLICATION_ENABLED=false
PROJECT_PUBLICATION_HOST=
PROJECT_PUBLICATION_BIND_ADDRESS=127.0.0.1
PROJECT_PUBLICATION_PORT_OFFSET=10000
