# Copy to .env.local only on a fresh checkout; never overwrite existing credentials.
# Replace each value with a different cryptographically random 64-character hex string.
# Keep .env.local permissions at 600. Never commit real values.
APP_DB_PASSWORD=replace_with_64_random_hex_characters
TEST_DB_PASSWORD=replace_with_a_different_64_character_hex_password

# Server-side only. Append these keys to an existing .env.local; never replace DB credentials.
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_TOKENS=16384
# Lifetime request ceiling for this database, not a currency budget; 0 disables paid requests.
GENERATION_MAX_MODEL_CALLS=0

# Optional trusted site origin, e.g. https://your-domain.example (no path).
# Empty means local-only publication links. Server template: deploy/server/.
PUBLIC_APP_ORIGIN=
