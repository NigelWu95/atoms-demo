<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>dev.atoms</groupId>
  <artifactId>atoms-demo</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Atoms Demo Studio</name>
  <properties>
    <java.version>17</java.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.23.2</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.session</groupId>
      <artifactId>spring-session-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <!-- Fixed resource includes; TemplatePackagingIT checks exact parity with the catalog. -->
    <!-- https://maven.apache.org/plugins/maven-resources-plugin/examples/include-exclude.html -->
    <resources>
      <resource><directory>src/main/resources</directory><filtering>false</filtering></resource>
      <resource>
        <directory>${project.basedir}/../templates</directory>
        <targetPath>engineering-templates</targetPath><filtering>false</filtering>
        <includes><include>standalone-v1.files</include></includes>
      </resource>
      <resource>
        <directory>${project.basedir}/../templates/standalone-v1</directory>
        <targetPath>engineering-templates/standalone-v1</targetPath><filtering>false</filtering>
        <includes>
          <include>.gitignore</include>
          <include>README.md</include>
          <include>THIRD-PARTY-NOTICES.md</include>
          <include>backend/.mvn/wrapper/maven-wrapper.properties</include>
          <include>backend/mvnw</include>
          <include>backend/pom.xml</include>
          <include>backend/src/main/java/dev/atoms/standalone/ApiError.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/ApiException.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/ApiExceptionHandler.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/AppController.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/AppStateService.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/ApplicationArtifactLoader.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/ApplicationHtml.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/DatabaseInstallation.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/DatabaseTarget.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/GuestIdentityService.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/HealthController.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/IdempotencyService.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/RequestBoundaryFilter.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/RuntimeDocumentPolicy.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/RuntimeDocumentService.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/RuntimeResources.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/SecurityConfiguration.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/SecurityHeadersFilter.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/SessionController.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/ShellController.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/StandaloneApplication.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/StartupConfig.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/StateController.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/StateDocument.java</include>
          <include>backend/src/main/java/dev/atoms/standalone/StateWriteRequest.java</include>
          <include>backend/src/main/resources/application.yml</include>
          <include>backend/src/main/resources/db/migration/V001__identity.sql</include>
          <include>backend/src/main/resources/db/migration/V002__app_state.sql</include>
          <include>backend/src/main/resources/db/migration/V003__idempotency.sql</include>
          <include>backend/src/main/resources/runtime/bootstrap.js</include>
          <include>backend/src/main/resources/runtime/document.html</include>
          <include>backend/src/test/java/dev/atoms/standalone/ApiBoundaryIT.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/ApiErrorsTest.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/ApplicationArtifactTest.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/DatabaseInstallationIT.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/DatabaseTargetTest.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/DedicatedDatabaseIT.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/HealthIT.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/PackagedRuntimeIT.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/RuntimeDocumentIT.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/RuntimeDocumentPolicyTest.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/RuntimeResourcesTest.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/SecurityHeadersTest.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/SessionIT.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/ShellIT.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/StartupConfigTest.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/StateHttpFixture.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/StateReadIT.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/StateWriteIT.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/StateWriteRequestTest.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/TestApplication.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/TestDatabase.java</include>
          <include>backend/src/test/java/dev/atoms/standalone/TestDatabaseTest.java</include>
          <include>backend/src/test/resources/application-test.yml</include>
          <include>config/application.properties.example</include>
          <include>frontend/.npmrc</include>
          <include>frontend/dev/boundary.spec.ts</include>
          <include>frontend/dev/boundary.ts</include>
          <include>frontend/eslint.config.js</include>
          <include>frontend/index.html</include>
          <include>frontend/package-lock.json</include>
          <include>frontend/package.json</include>
          <include>frontend/public/favicon.svg</include>
          <include>frontend/src/App.spec.ts</include>
          <include>frontend/src/App.vue</include>
          <include>frontend/src/RuntimeFrame.spec.ts</include>
          <include>frontend/src/RuntimeFrame.vue</include>
          <include>frontend/src/api/client.spec.ts</include>
          <include>frontend/src/api/client.ts</include>
          <include>frontend/src/api/health.spec.ts</include>
          <include>frontend/src/api/health.ts</include>
          <include>frontend/src/api/responses.ts</include>
          <include>frontend/src/api/state.spec.ts</include>
          <include>frontend/src/api/state.ts</include>
          <include>frontend/src/main.ts</include>
          <include>frontend/src/runtime/bridge.spec.ts</include>
          <include>frontend/src/runtime/bridge.ts</include>
          <include>frontend/src/runtime/mountFrame.spec.ts</include>
          <include>frontend/src/runtime/mountFrame.ts</include>
          <include>frontend/src/runtime/protocol.spec.ts</include>
          <include>frontend/src/runtime/protocol.ts</include>
          <include>frontend/src/runtime/randomId.ts</include>
          <include>frontend/src/styles.css</include>
          <include>frontend/src/useStartup.ts</include>
          <include>frontend/tsconfig.json</include>
          <include>frontend/vite.config.ts</include>
          <include>licenses/maven-wrapper-LICENSE.txt</include>
          <include>licenses/maven-wrapper-NOTICE.txt</include>
          <include>scripts/build-inputs.mjs</include>
          <include>scripts/build-inputs.test.mjs</include>
          <include>scripts/build.mjs</include>
          <include>scripts/build.test.mjs</include>
          <include>scripts/init-config.mjs</include>
          <include>scripts/init-config.test.mjs</include>
          <include>scripts/package-application.mjs</include>
          <include>scripts/package-application.test.mjs</include>
          <include>scripts/process.mjs</include>
          <include>scripts/process.test.mjs</include>
          <include>scripts/start.mjs</include>
          <include>scripts/start.test.mjs</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <!-- The allowlisted template .gitignore must survive the archive phase as well. -->
        <configuration><addDefaultExcludes>false</addDefaultExcludes></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <configuration><addDefaultExcludes>false</addDefaultExcludes></configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration><failIfNoTests>true</failIfNoTests></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration><failIfNoTests>true</failIfNoTests></configuration>
        <executions>
          <execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
