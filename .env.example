# Local development only. Generate a random password before first startup.
# Real credentials belong in .env, never in this template.
POSTGRES_PASSWORD=replace_with_a_random_local_password
# Platform connections: five coordinator leases plus worker transactions and HTTP requests.
# Keep headroom when both legacy and full-project execution modules are enabled.
DB_POOL_MAX_SIZE=16

# Full-project execution is an opt-in module, independent of the old build/runtime switches.
# Native processes are not an OS sandbox. Enable only in your configured development environment.
# Explicit absolute tool paths and a private, reviewed dependency policy are required.
PROJECT_EXECUTION_ENABLED=false
PROJECT_WORKBENCH_ENABLED=false
# Route normal project pages to Claude Code; reject new legacy /runs submissions.
PROJECT_WORKBENCH_DEFAULT_MODE=false
# All authenticated project owners, including cookie-based guests, may develop their own projects.
# Does not grant maintenance permissions or cross-project access.
PROJECT_WORKBENCH_OWNER_ACCESS=false
# Delivery uses the exact frontend origin, e.g. http://127.0.0.1:5173 (no trailing slash).
PROJECT_DELIVERY_ENABLED=false
PROJECT_DELIVERY_ORIGIN=
PROJECT_EXECUTION_ROOT=
PROJECT_EXECUTION_NODE=
PROJECT_EXECUTION_NPM=
PROJECT_EXECUTION_JAVA=
PROJECT_EXECUTION_MAVEN=
PROJECT_EXECUTION_POLICY=
PROJECT_EXECUTION_MAINTAINER_IDS=
# JSON object: canonical project UUID -> absolute private test .properties path (1-4 entries).
# Credentials stay in 0600 files under 0700 directories outside source/Agent/execution roots.
# Loaded at coordinator startup. Changes require stopping and restarting the coordinator.
PROJECT_EXECUTION_TEST_DATABASES=
# Optional JSON map with the same format; project keys must also exist in TEST_DATABASES.
# Separate purpose=runtime private files include the application's port. Blank keeps build-only resources.
# Assembly does not start applications; an authorized request uses the coordinator's separate resident workers.
PROJECT_EXECUTION_RUNTIME_DATABASES=
# Optional auto-assignment pool: runtime binding UUID -> {"test":"/private/test.properties","runtime":"/private/runtime.properties"}.
# Fixed mappings + pool <= 4. Pre-provision distinct pairs; first build binds one permanently to the project.
# Never put passwords in this JSON. A stopped app does not release/recycle its database.
PROJECT_EXECUTION_DATABASE_POOL=
# Applied at startup: build concurrency 1-4, queue 1-8, running projects 1-4.
PROJECT_EXECUTION_MAX_CONCURRENT_BUILDS=1
PROJECT_EXECUTION_QUEUE_CAPACITY=8
PROJECT_EXECUTION_MAX_RUNNING_PROJECTS=4
# Positive seconds, no larger than the following approved ceilings.
PROJECT_EXECUTION_TASK_TIMEOUT_SECONDS=1800
PROJECT_EXECUTION_QUEUE_TIMEOUT_SECONDS=300
PROJECT_EXECUTION_START_TIMEOUT_SECONDS=120
# Fixed limits: 8 GiB execution root, 1 GiB free, 256 MiB JAR,
# 64 KiB diagnostics / 1000 events per task, pages <=100; no automatic cleanup.

# Full-project Agent is opt-in; OWNER_ACCESS above opens it to project owners including guests.
# No CLI, state directory or API key is accessed while disabled.
# These do not replace the existing generation quota or DEEPSEEK_MAX_TOKENS.
PROJECT_AGENT_ENABLED=false
PROJECT_AGENT_LIVE_ENABLED=false
PROJECT_AGENT_CLI=
PROJECT_AGENT_STATE_ROOT=
PROJECT_AGENT_MAINTAINER_IDS=
PROJECT_AGENT_MAX_LIVE_RUNS=0
PROJECT_AGENT_MAX_OUTPUT_TOKENS=128000
# Tool-call turns per task, range 1-128. Existing tasks retain their original budget.
PROJECT_AGENT_MAX_TURNS=64
PROJECT_AGENT_TASK_TIMEOUT_SECONDS=1800
PROJECT_AGENT_QUEUE_TIMEOUT_SECONDS=300
# Different projects may run in parallel; same-project edits remain exclusive.
# Range 1-8, applied at startup. This does not change the live-run budget.
PROJECT_AGENT_MAX_CONCURRENT_TASKS=4
